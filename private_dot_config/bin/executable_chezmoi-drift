#!/bin/sh
set -eu

drift_marker="${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-drift"
mkdir -p "$(dirname "$drift_marker")"
drift_report=$(chezmoi status --exclude scripts) || exit 0

if [ -n "$drift_report" ]; then
    printf '%s\n' "$drift_report" | wc -l | tr -d ' ' > "$drift_marker"
else
    rm -f "$drift_marker"
fi
