rerun() {
  local delay=${RERUN_DELAY:-3}
  local max_retries=${RERUN_MAX:-0}
  local count=0
  local child_pid input

  setopt localoptions monitor

  _kill_tree() {
    local pid=$1
    pkill -TERM -P $pid 2>/dev/null
    kill -TERM -$pid 2>/dev/null || kill -TERM $pid 2>/dev/null
  }

  _cleanup() {
    [[ -n "$child_pid" ]] && _kill_tree $child_pid
    unfunction _kill_tree _cleanup 2>/dev/null
    trap - INT TERM
  }

  trap '_cleanup; echo; return 130' INT TERM

  while true; do
    "$@" &
    child_pid=$!

    while kill -0 $child_pid 2>/dev/null; do
      if read -t 1 -r input 2>/dev/null; then
        if [[ "$input" == "rs" ]]; then
          printf "\n🔄 Restarting...\n"
          _kill_tree $child_pid
          wait $child_pid 2>/dev/null
          count=0
          continue 2
        fi
      fi
    done

    wait $child_pid
    local code=$?

    [[ $code -eq 0 ]] && break

    ((count++))
    if [[ $max_retries -gt 0 && $count -ge $max_retries ]]; then
      printf "\n❌ Max retries (%d) reached.\n" "$max_retries"
      _cleanup
      return $code
    fi

    printf "\n⚠️ Exit %d. Retry #%d in %ds... [rs + Enter = restart, Ctrl+C = quit]\n" "$code" "$count" "$delay"

    for ((i=0; i<delay; i++)); do
      if read -t 1 -r input 2>/dev/null && [[ "$input" == "rs" ]]; then
        break
      fi
    done
  done

  _cleanup
}

