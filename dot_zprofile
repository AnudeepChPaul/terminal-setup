_cleanup_dc() {
    docker info || return 1;
    docker compose down || return 1;
    docker container prune --force;
    docker image prune --all --force;
    docker volume prune --force;
}

_tn() {   # $1 = session name, $2 = optional exact path (used in preference to zoxide)
    local session_name="$1" session_dir="$2"
    [[ -n $session_name ]] || return 1
    [[ -d $session_dir ]] || session_dir=$(zoxide query "$session_name" 2>/dev/null)
    [[ -d $session_dir ]] || session_dir=$PWD

    tmux new-session -s "$session_name" -n "main:${session_name}" -c "$session_dir" -d 2>/dev/null
    tmux attach -t "$session_name" 2>/dev/null || tmux switchc -t "$session_name" 2>/dev/null
}

