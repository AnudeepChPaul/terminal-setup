plz() {   # re-run the previous command under sudo, with confirmation
  local last=$(fc -ln -1)
  [[ -n $last ]] || { print -u2 "plz: no previous command"; return 1 }
  print -r -- "sudo $last"
  read -q "?run this as root? [y/N] " || { print; return 1 }
  print
  eval "sudo $last"
}
