source "$HOME/.config/zsh/no-omz.zsh"

# Sets cursor to blinking block
[[ -o interactive && -t 1 ]] && printf '\e[5 q'

zstyle ':completion:*' file-sort modification
zstyle :compinstall filename "$HOME/.zshrc"

autoload -Uz zkbd

# atuin owns interactive history (^R and up-arrow). zsh's own history is kept
# only for `!!`, `fc`, and the `plz` alias — hence the unsetopt, which also
# overrides oh-my-zsh/lib/history.zsh:48.
HISTFILE=~/.histfile
HISTSIZE=50000
SAVEHIST=50000
setopt autocd extendedglob
setopt hist_ignore_space hist_ignore_all_dups hist_reduce_blanks
unsetopt share_history

ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
ZSH_AUTOSUGGEST_MANUAL_REBIND=1        # skip widget re-binding on every precmd
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20     # no suggestion work on large pasted buffers
