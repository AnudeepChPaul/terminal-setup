source ~/.zprofile
# eval "$(zoxide init zsh)"
_zcache zoxide init zsh

# --- vi mode ---------------------------------------------------------------
bindkey -v
export KEYTIMEOUT=5   # 50ms. At 10ms there is no margin for ESC-prefixed
                      # Alt-keys (Alt-C, Alt-e); Esc into vicmd still feels instant.

# `v` in command mode opens the line in $EDITOR, as in vim
autoload -Uz edit-command-line; zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line

# text objects: ci" ca' di( ya[ ...  (not enabled by default in zsh)
autoload -Uz select-bracketed select-quoted
zle -N select-bracketed; zle -N select-quoted
for km in viopp visual; do
  for c in {a,i}${(s..)^:-'()[]{}<>bB'}; bindkey -M $km $c select-bracketed
  for c in {a,i}${(s..)^:-\'\"\`};       bindkey -M $km $c select-quoted
done

# vim-surround: ys / cs / ds, and S in visual mode
autoload -Uz surround
zle -N delete-surround surround
zle -N add-surround surround
zle -N change-surround surround
bindkey -M vicmd 'ys' add-surround
bindkey -M vicmd 'cs' change-surround
bindkey -M vicmd 'ds' delete-surround
bindkey -M visual 'S' add-surround

# repeat-last-f/t with ; and , (vi defaults zsh omits)
bindkey -M vicmd ';' vi-repeat-find
bindkey -M vicmd ',' vi-rev-repeat-find

# cursor shape follows the mode
function zle-keymap-select {
  case $KEYMAP in
    vicmd) printf '\e[2 q';;   # block
    *)     printf '\e[5 q';;   # blinking bar
  esac
}
zle -N zle-keymap-select
function zle-line-init { printf '\e[5 q' }
zle -N zle-line-init

# --- fzf ------------------------------------------------------------------
# Sourced BEFORE atuin so atuin keeps ^R. fzf also grabs ^T and Tab; both are
# reassigned immediately after.
# source <(fzf --zsh)
_zcache fzf --zsh
bindkey -r '^T'
bindkey '^F' fzf-file-widget          # fzf file picker (^T stays tmux)
bindkey '^I' fzf-tab-complete         # fzf-tab owns Tab, not fzf-completion

# --- fzf-tab previews -----------------------------------------------------
# directories via eza, files via bat, diffs via delta
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons $realpath'
zstyle ':fzf-tab:complete:*:*'  fzf-preview \
  '[[ -d $realpath ]] && eza -1 --color=always --icons $realpath || bat -n --color=always --line-range :200 $realpath 2>/dev/null'
zstyle ':fzf-tab:complete:git-(add|diff|restore|checkout):*' fzf-preview \
  'git diff --color=always -- $word | delta'
zstyle ':fzf-tab:complete:git-(log|show):*' fzf-preview \
  'git log --color=always --oneline --graph $word'

# render in a tmux popup; , / . switch completion groups
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
zstyle ':fzf-tab:*' popup-min-size 80 12
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:*' continuous-trigger '/'

# --- fzf editor widgets ---------------------------------------------------
# ^F inserts a path; Alt-c searches contents and opens nvim at the line.
# Follows fzf's own widget pattern (read < /dev/tty, redisplay on cancel,
# push-line/accept-line/reset-prompt).

# Alt-c — search contents with rg, open at the matching line.
# rg needs -H or it omits the filename when a single file matches.
fzf-rg-widget() {
  setopt localoptions pipefail no_aliases 2>/dev/null
  local rgcmd='rg -H --column --line-number --no-heading --color=always --smart-case'
  local hit
  hit=$(fzf --ansi --disabled --height 70% --reverse --border --prompt 'rg> ' \
        --delimiter : \
        --bind "start:reload:$rgcmd {q} || true" \
        --bind "change:reload:sleep 0.1; $rgcmd {q} || true" \
        --preview 'bat --color=always --highlight-line {2} --line-range :300 {1}' \
        --preview-window 'right,60%,+{2}/3' < /dev/tty)
  if [[ -z $hit ]]; then zle redisplay; return 0; fi
  local f=${hit%%:*} l=${${hit#*:}%%:*}
  zle push-line
  BUFFER="${EDITOR:-nvim} +${l} ${(q)f}"
  zle accept-line
  local ret=$?
  unset hit f l
  zle reset-prompt
  return $ret
}
# Execute "command a" on Ctrl+N
# zle -N _run_command_digest_app
# bindkey '^N' _run_command_digest_app
zle -N fzf-rg-widget
bindkey '\ec' fzf-rg-widget    # content search (takes \ec from fzf's default)
bindkey '\ee' fzf-cd-widget    # cd (fzf's own widget, moved off \ec)

